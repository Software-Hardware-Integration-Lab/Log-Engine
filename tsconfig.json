{
    "extends": "@software-hardware-integration-lab/development-utilities/config/typescript/base.json",
    // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
        "types": [
            "node"
        ],
        "paths": {
            "#/*": [
                "./src/*"
            ]
        },
        // Required for tests
        "rootDir": "./src",
        "outDir": "./bin",
        "declaration": true,
        "plugins": [
            {
                "transform": "typia/lib/transform"
            }
        ]
    },
    // Include all TypeScript files in the src directory and its subdirectories
    "include": [
        "src/**/*.ts"
    ]
}
