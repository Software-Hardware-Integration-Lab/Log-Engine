{
    "version": "0.0.2",
    "name": "@software-hardware-integration-lab/log-engine",
    "description": "Logging engine with ability to add plugins for any destination",
    "type": "module",
    "scripts": {
        "build": "npm run clean:bin && ttsc -p tsconfig.json",
        "build:coverage": "npm run clean:bin && ttsc -p coverage.tsconfig.json",
        "build:prod": "npm run clean:bin && ttsc -p prod.tsconfig.json",
        "clean:bin": "node ./scripts/clean-bin.mjs",
        "test": "npm run build:coverage && vitest run",
        "test:watch": "vitest",
        "coverage": "npm run build:coverage && vitest run --coverage",
        "validate:package": "npm run coverage && npm run build:prod && node ./scripts/validate-package.mjs",
        "prepack": "npm run validate:package"
    },
    "imports": {
        "#/*": {
            "types": "./src/*",
            "default": "./bin/*"
        }
    },
    "exports": {
        ".": {
            "types": "./bin/index.d.ts",
            "import": "./bin/index.js"
        }
    },
    "types": "./bin/index.d.ts",
    "files": [
        "bin",
        "README.md",
        "LICENSE"
    ],
    "compilerOptions": {
        "plugins": [
            {
                "transform": "typia/lib/transform"
            }
        ]
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "typia": "^13.1.19"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@vitest/coverage-v8": "^4.1.10",
        "ttsc": "^0.19.3",
        "typescript": "^7.0.2",
        "vitest": "^4.1.10"
    }
}
